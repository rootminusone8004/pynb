<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/editorToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface_light"
        app:navigationIcon="@drawable/ic_close"
        app:navigationContentDescription="@string/cancel"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_light" />

    <ScrollView
        android:id="@+id/editorScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <EditText
            android:id="@+id/etCellSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:gravity="top|start"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textNoSuggestions"
            android:lineSpacingMultiplier="1.15"
            android:minHeight="240dp"
            android:padding="14dp"
            android:textColor="@color/text_primary_light"
            android:textSize="14sp"
            android:hint="@string/editor_hint" />
    </ScrollView>

    <!-- Extra keys that are awkward to reach on phone keyboards -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_variant_light"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutKeyBar"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp" />
    </HorizontalScrollView>
</LinearLayout>
